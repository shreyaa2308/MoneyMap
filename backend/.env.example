# Copy this file to backend/.env and fill in the values there.
# backend/.env is ignored by Git. Do not put a real key in this example.

# development uses a local token secret when MONEYMAP_JWT_SECRET is unset.
# Any other MONEYMAP_ENV value requires a private MONEYMAP_JWT_SECRET.
MONEYMAP_ENV=development
MONEYMAP_JWT_SECRET=

# Set to 1 to skip the fictional demo user on startup.
MONEYMAP_SKIP_SEED=

# Leave the key blank to keep MoneyMap working with the assistant turned off.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Default is gpt-4o-mini, a low-cost text model on the Responses API.
# Change this if your API account does not have that model.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20
OPENAI_MAX_OUTPUT_TOKENS=400
